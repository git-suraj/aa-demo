KONG_CLUSTER_CONTROL_PLANE=YOUR_KONNECT_CP_HOST:443
KONG_CLUSTER_SERVER_NAME=YOUR_KONNECT_CP_HOST
KONG_CLUSTER_TELEMETRY_ENDPOINT=d1c7e1d38b.us.tp.konghq.com:443
KONG_CLUSTER_TELEMETRY_SERVER_NAME=d1c7e1d38b.us.tp.konghq.com
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DECK_OPENAI_API_KEY=
# DECK_GEMINI_API_KEY=
# AI Gateway 2.0 provider credentials. Include the `Bearer ` prefix for OpenAI.
# AIGW_OPENAI_AUTHORIZATION="Bearer YOUR_OPENAI_API_KEY"
# AIGW_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
AIGW_CONSUMER1_API_KEY=consumer1-demo-key
AIGW_CONSUMER2_API_KEY=consumer2-demo-key
AIGW_INTERNAL_ROUTER_API_KEY=internal-router-key
AIGW_ORCHESTRATOR_API_KEY=orchestrator-demo-key
AIGW_SUCCESS_AGENT_API_KEY=success-demo-key
AIGW_SUPPORT_AGENT_API_KEY=support-demo-key
AIGW_UI_API_KEY=ui-demo-key
DECK_OPENAI_MODEL=gpt-4o-mini
DECK_OPENAI_SELECTOR_MODEL=o3-mini
DECK_GEMINI_MODEL=gemini-2.5-flash
DECK_INTERNAL_ROUTER_KEY=internal-router-key
DECK_REDIS_HOST=redis-stack
KONNECT_TOKEN="YOUR_KONNECT_PAT"
KONNECT_CONTROL_PLANE_NAME="YOUR_KONNECT_CONTROL_PLANE_NAME"
KONNECT_CP_ID=73d2189b-8711-47c2-a11e-7e122eabd1d7
# AI Gateway 2.0 data plane for AA-Demo-2 (not the legacy Kong control plane).
AIGW_CLUSTER_CONTROL_PLANE=03c59b7ac6.us.cp.konghq.com:443
AIGW_CLUSTER_SERVER_NAME=03c59b7ac6.us.cp.konghq.com
AIGW_CLUSTER_TELEMETRY_ENDPOINT=03c59b7ac6.us.tp.konghq.com:443
AIGW_CLUSTER_TELEMETRY_SERVER_NAME=03c59b7ac6.us.tp.konghq.com
# AI Gateway runtime image (the legacy kong-dp remains on Kong Gateway 3.14).
KONG_IMAGE_REPO=kong
KONG_IMAGE_NAME=kong-ai-gateway-dev
KONG_IMAGE_TAG=2.0.1-rc.5
DECK_LAKERA_API_KEY=
DECK_LAKERA_PROJECT=

# Dashboard UI language: en | ja | ko (rendered into the UI at container start)
UI_LANG=en

# Copy Konnect-issued DP certificates into ./kong/certs
# kong/certs/tls.crt
# kong/certs/tls.key

# Optional: LM Studio embeddings for semantic guard/cache/load balancing
# If DECK_LM_STUDIO_URL is set, ./scripts/start_rag_demo.sh will route embeddings
# for those semantic scenarios to LM Studio instead of OpenAI.
# DECK_LM_STUDIO_URL=http://localhost:1234
# DECK_LM_STUDIO_API_KEY=
# DECK_LM_STUDIO_MODEL=text-embedding-mxbai-embed-large-v1
