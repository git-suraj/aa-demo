# Self-hosted Kong Gateway Enterprise
# The control plane and data plane addresses are defined in docker-compose.yml.
KONG_PG_PASSWORD=kong
# Paste the complete Enterprise license JSON on one line.
# KONG_LICENSE_DATA='{"license": { ... }}'
KONG_LICENSE_DATA=

# LLM providers used by the self-hosted AI plugin configuration.
DECK_OPENAI_API_KEY=
DECK_GEMINI_API_KEY=
DECK_OPENAI_SELECTOR_MODEL=o3-mini
DECK_GEMINI_MODEL=gemini-2.5-flash

# Gateway configuration values.
DECK_INTERNAL_ROUTER_KEY=internal-router-key
DECK_REDIS_HOST=redis-stack

# Optional Lakera policy scenario.
DECK_LAKERA_API_KEY=
DECK_LAKERA_PROJECT=

# Optional local embeddings for semantic guard, cache, and load-balancing scenarios.
# Leave these unset to use OpenAI embeddings.
# DECK_LM_STUDIO_URL=http://localhost:1234
# DECK_LM_STUDIO_API_KEY=
# DECK_LM_STUDIO_MODEL=text-embedding-mxbai-embed-large-v1

# UI language: en, ja, or ko.
UI_LANG=en

# Optional observability settings.
# OPIK_OTLP_TRACES_ENDPOINT=http://opik-frontend:5173/api/v1/private/otel
# OPIK_API_KEY=
# OPIK_WORKSPACE=default
# OPIK_PROJECT_NAME=aa-demo-kong
# OPIK_FRONTEND_PORT=5173

# Optional timeout for ./scripts/start_self_hosted_demo.sh NORMAL_RUN.
# RUN_NORMAL_DEMO_TIMEOUT_SECONDS=240
